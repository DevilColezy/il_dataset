<?xml version="1.0"?>
<package format="2">
  <name>il_dataset</name>
  <version>0.2.0</version>
  <description>
    Imitation-Learning Dataset Collection — automated expert-demonstration
    data acquisition with state-machine orchestration, ESDF-based C++ local
    receding-horizon trajectory planning, and async depth-image recording
    via AvoidBench Unity.
  </description>

  <maintainer email="user@example.com">flightmare_ws user</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <build_depend>rospy</build_depend>
  <build_depend>flightlib</build_depend>
  <build_depend>std_msgs</build_depend>
  <build_depend>eigen</build_depend>
  <!-- Optional but recommended: sudo apt install libnlopt-cxx-dev -->
  <build_depend>nlopt</build_depend>

  <exec_depend>rospy</exec_depend>
  <exec_depend>flightlib</exec_depend>
  <exec_depend>rospkg</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>flightmare_dataset_tools</exec_depend>
  <exec_depend>eigen</exec_depend>
  <exec_depend>python3-matplotlib</exec_depend>

  <!-- Python dependencies (must be installed manually or via requirements.txt) -->
  <!--   pip3 install pybind11 numpy scipy pillow pyzmq pyyaml -->

  <export>
  </export>
</package>
