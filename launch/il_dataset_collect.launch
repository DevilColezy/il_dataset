<?xml version="1.0"?>
<!-- ===================================================================
  IL dataset collection — NEW hierarchical local expert (single production
  path; schema v25 + two_level_expert_labels_v1).

  Both il_dataset_collect.launch and il_dataset_joint_v2_collect.launch
  start the SAME node (il_manager.py) with the SAME expert stack:

    C++ scene/task generation + preflight
      -> Flightmare current depth frame
      -> C++ local observation + causal history map
      -> 5 Hz VisibilityTargetCorrector
      -> EffectiveTargetAdapter
      -> 30 Hz LocalPlanner30Hz
      -> FlightmareDynamics (_flightmare_dynamics)
      -> new two-level labels written to data.csv

  The manager instantiates exactly ONE C++ HierarchicalExpert
  (_il_hierarchical_expert); it is the sole generator of every horizontal
  control command.  There is no config-based dispatch between old and new
  experts, and no legacy expert module runs.

  USAGE (collection starts automatically after launch):

    1. Start AvoidBench externally in another terminal (the launch never
       starts or stops AvoidBench):
         cd ~/flightmare_ws/RPG_Flightmare/AvoidBench_x
         ./AvoidBench.x86_64 -input-port 10253 -output-port 10254

    2. Run:
         roslaunch il_dataset il_dataset_collect.launch

    3. Collection: connect AvoidBench -> generate procedural scene (full-
       height cylinders, truth for generation only) -> sample start/goal at
       one flight height with truth connectivity screening -> closed-loop
       preflight with the SAME expert (PreflightSimulator) -> real
       Flightmare episode (expert -> altitude-hold vz merge -> Flightmare)
       -> commit/reject by the two-level rules -> NEXT_TASK -> NEXT_SCENE.

  Custom config:
      roslaunch il_dataset il_dataset_collect.launch \
        config_file:=/path/to/my_config.yaml

  Dry-run (validate config + preflight qualification only, no Unity):
      roslaunch il_dataset il_dataset_collect.launch dry_run:=true

  Blueprint-only preflight (qualify tasks with the same expert, write
  joint_v2_blueprint_manifest.json, do not connect Unity):
      roslaunch il_dataset il_dataset_collect.launch blueprint_only:=true
  ==================================================================== -->
<launch>
  <param name="use_sim_time" value="false"/>

  <arg name="config_file"
       default="$(find il_dataset)/config/il_dataset_joint_v2_config.yaml"/>
  <arg name="dry_run" default="false"/>
  <arg name="blueprint_only" default="false"/>
  <!-- Path to libasan for ASan debugging (native heap crash diagnosis).
       Empty by default (normal runs are unaffected).  When debugging a
       native crash, pass the full path, e.g.
         roslaunch il_dataset il_dataset_collect.launch \
           asan_libasan:=$(g++ -print-file-name=libasan.so)
       LD_PRELOAD is applied to the MANAGER node ONLY (never to roslaunch /
       roscore), because preloading it in the whole shell makes every child
       process crash with "AddressSanitizer: DEADLYSIGNAL". -->
  <arg name="asan_libasan" default=""/>

  <!-- ════════════════════════════════════════════════════════════
       IL Manager Node  (the ONLY node needed)
       ════════════════════════════════════════════════════════════ -->
  <node pkg="il_dataset" type="il_manager.py"
        name="il_dataset_manager" output="screen" required="true">
    <env name="LD_PRELOAD" value="$(arg asan_libasan)"
         unless="$(eval arg('asan_libasan') == '')"/>
    <env name="ASAN_OPTIONS" value="detect_leaks=0:abort_on_error=1"
         unless="$(eval arg('asan_libasan') == '')"/>
    <param name="config_file" value="$(arg config_file)"/>
    <param name="dry_run" value="$(arg dry_run)"/>
    <param name="blueprint_only" value="$(arg blueprint_only)"/>
  </node>

</launch>
