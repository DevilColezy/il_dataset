<?xml version="1.0"?>
<!-- ===================================================================
  Automatic multi-scale IL dataset collection (two-level navigation
  expert, schema v22).

  Wire contract (verified topics): scene + runtime messages use the
  `Pose` topic; point cloud export uses the `PointCloud` topic.  The
  AvoidBench `scene_id` is the numeric `global.scene_id` from the config;
  the procedural dataset scene key (`scene_*_NNNNNN`) is NEVER sent to
  AvoidBench — it only names dataset directories / manifests / PLY files.

  USAGE (collection starts automatically after launch):

    1. Start AvoidBench externally in another terminal (the launch never
       starts or stops AvoidBench):
         cd ~/flightmare_ws/RPG_Flightmare/AvoidBench_x
         ./AvoidBench.x86_64 -input-port 10253 -output-port 10254

    2. Run:
         roslaunch il_dataset il_dataset_collect.launch

    3. Collection starts automatically: connect AvoidBench -> generate
       scene -> send via Pose -> wait ready -> export one point cloud ->
       build privileged scene map -> generate multiscale tasks -> run each
       task (5 Hz macro + 30 Hz local + recording) -> NEXT_TASK ->
       NEXT_SCENE -> NEXT_PROFILE -> DONE.  No task manifests / manual
       start-goal / scene interaction is required as input (manifests are
       written as OUTPUTS per scene/task).

    Custom config:
      roslaunch il_dataset il_dataset_collect.launch \
        config_file:=/path/to/my_config.yaml

    Dry-run (validate config + print the generation plan only):
      roslaunch il_dataset il_dataset_collect.launch dry_run:=true
  ==================================================================== -->
<launch>
  <param name="use_sim_time" value="false"/>

  <arg name="config_file"
       default="$(find il_dataset)/config/il_dataset_config.yaml"/>
  <arg name="dry_run" default="false"/>
  <!-- Path to libasan for ASan debugging (native heap crash diagnosis).
       Empty by default (normal runs are unaffected).  When debugging the
       native "double free or corruption" crash, pass the full path, e.g.
         roslaunch il_dataset il_dataset_collect.launch \
           asan_libasan:=$(g++ -print-file-name=libasan.so)
       LD_PRELOAD is applied to the MANAGER node ONLY (never to roslaunch /
       roscore), because preloading it in the whole shell makes every child
       process crash with "AddressSanitizer: DEADLYSIGNAL". -->
  <arg name="asan_libasan" default=""/>

  <!-- ════════════════════════════════════════════════════════════
       IL Manager Node  (the ONLY node needed)
       ════════════════════════════════════════════════════════════ -->
  <node pkg="il_dataset" type="il_manager.py"
        name="il_dataset_manager" output="screen" required="true">
    <env name="LD_PRELOAD" value="$(arg asan_libasan)"
         unless="$(eval arg('asan_libasan') == '')"/>
    <env name="ASAN_OPTIONS" value="detect_leaks=0:abort_on_error=1"
         unless="$(eval arg('asan_libasan') == '')"/>
    <param name="config_file" value="$(arg config_file)"/>
    <param name="dry_run" value="$(arg dry_run)"/>
  </node>

</launch>
