<?xml version="1.0"?>
<!-- ===================================================================
  Two-level navigation-expert IL dataset collection (schema v18).

  The manager runs the sole supported pipeline: task manifest loading,
  privileged global map build, causal observed map, 5 Hz macro expert
  (DIRECT/SIDE/OBSERVE/GOAL_REACHED/FAILED), 30 Hz A*-seeded B-spline
  local planner, execution safety, trajectory controller and lockstep
  recording.

  AvoidBench / Unity must be started manually BEFORE launching:
    cd ~/flightmare_ws/RPG_Flightmare/AvoidBench_x
    ./AvoidBench.x86_64 -input-port 10253 -output-port 10254

  ── USAGE ──────────────────────────────────────────────────────
    roslaunch il_dataset il_dataset_collect.launch

    # Custom config:
    roslaunch il_dataset il_dataset_collect.launch \
      config_file:=/path/to/my_config.yaml

    # Dry-run (config validation only):
    roslaunch il_dataset il_dataset_collect.launch dry_run:=true
  ==================================================================== -->
<launch>
  <param name="use_sim_time" value="false"/>

  <arg name="config_file"
       default="$(find il_dataset)/config/il_dataset_config.yaml"/>
  <arg name="dry_run" default="false"/>

  <!-- ════════════════════════════════════════════════════════════
       IL Manager Node  (the ONLY node needed)
       ════════════════════════════════════════════════════════════ -->
  <node pkg="il_dataset" type="il_manager.py"
        name="il_dataset_manager" output="screen" required="true">
    <param name="config_file" value="$(arg config_file)"/>
    <param name="dry_run" value="$(arg dry_run)"/>
  </node>

</launch>
