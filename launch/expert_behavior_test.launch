<?xml version="1.0"?>
<!--
  Collect one expert trajectory and open an interactive top-view diagnostic.

  Distributions:
    small_sparse | medium_dense | large_sparse | mixed_dense

  Example:
    roslaunch il_dataset expert_behavior_test.launch distribution:=medium_dense
-->
<launch>
  <param name="use_sim_time" value="false"/>

  <arg name="config_file"
       default="$(find il_dataset)/config/il_dataset_config.yaml"/>
  <arg name="distribution" default="small_sparse"/>
  <arg name="seed" default="12345"/>
  <arg name="output_dir"
       default="$(find il_dataset)/dataset/expert_behavior_test"/>
  <arg name="show_plot" default="true"/>
  <arg name="debug" default="false"/>

  <node pkg="il_dataset" type="expert_behavior_test.py"
        name="expert_behavior_test" output="screen" required="true">
    <param name="config_file" value="$(arg config_file)"/>
    <param name="distribution" value="$(arg distribution)"/>
    <param name="seed" value="$(arg seed)"/>
    <param name="output_dir" value="$(arg output_dir)"/>
    <param name="show_plot" value="$(arg show_plot)"/>
    <param name="debug" value="$(arg debug)"/>
  </node>
</launch>
