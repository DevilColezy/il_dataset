<?xml version="1.0"?>
<!--
  Run deterministic expert scenarios and open interactive diagnostics.

  Default: run the human_review suite in catalog order. Close each plot to
  continue to the next scenario.

  Example:
    roslaunch il_dataset expert_behavior_test.launch suite:=quick_check
    roslaunch il_dataset expert_behavior_test.launch suite:=single_obstacles
    roslaunch il_dataset expert_behavior_test.launch suite:=clutter_review
    roslaunch il_dataset expert_behavior_test.launch suite:=all
    roslaunch il_dataset expert_behavior_test.launch scenario:=large_early_center
-->
<launch>
  <param name="use_sim_time" value="false"/>

  <arg name="config_file"
       default="$(find il_dataset)/config/il_dataset_config.yaml"/>
  <!-- A non-empty scenario selects one case; otherwise suite is expanded. -->
  <arg name="scenario" default=""/>
  <arg name="suite" default="human_review"/>
  <arg name="scenario_file"
       default="$(find il_dataset)/config/expert_behavior_scenarios.yaml"/>
  <arg name="seed" default="12345"/>
  <arg name="output_dir"
       default="$(find il_dataset)/dataset/expert_behavior_test"/>
  <arg name="show_plot" default="true"/>
  <arg name="stop_on_failure" default="false"/>
  <arg name="debug" default="false"/>

  <group if="$(eval arg('scenario') != '')">
    <node pkg="il_dataset" type="expert_behavior_test.py"
          name="expert_behavior_test" output="screen" required="true">
      <param name="config_file" value="$(arg config_file)"/>
      <param name="scenario" value="$(arg scenario)"/>
      <param name="scenario_file" value="$(arg scenario_file)"/>
      <param name="seed" value="$(arg seed)"/>
      <param name="output_dir" value="$(arg output_dir)"/>
      <param name="show_plot" value="$(arg show_plot)"/>
      <param name="debug" value="$(arg debug)"/>
    </node>
  </group>

  <group unless="$(eval arg('scenario') != '')">
    <node pkg="il_dataset" type="expert_behavior_suite.py"
          name="expert_behavior_suite" output="screen" required="true"
          args="--selection $(arg suite)
                --scenario-file $(arg scenario_file)
                --config-file $(arg config_file)
                --output-dir $(arg output_dir)
                --seed $(arg seed)
                --show-plot $(arg show_plot)
                --stop-on-failure $(arg stop_on_failure)
                --debug $(arg debug)"/>
  </group>
</launch>
