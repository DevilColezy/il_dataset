<?xml version="1.0"?>
<!--
  Offline regression for the observation-conditioned global rollout.

  Examples:
    roslaunch il_dataset observation_rollout_scenario_test.launch
    roslaunch il_dataset observation_rollout_scenario_test.launch \
      scenario:=scale_transition
    roslaunch il_dataset observation_rollout_scenario_test.launch \
      scenario:="large_early_center,double_slalom"
-->
<launch>
  <param name="use_sim_time" value="false"/>

  <arg name="config_file"
       default="$(find il_dataset)/config/il_dataset_config.yaml"/>
  <!-- all, one scenario name, or a comma-separated list -->
  <arg name="scenario" default="all"/>
  <arg name="scenario_file"
       default="$(find il_dataset)/config/expert_behavior_scenarios.yaml"/>
  <arg name="print_decisions" default="true"/>
  <arg name="show_plot" default="true"/>
  <arg name="fail_on_error" default="true"/>

  <node pkg="il_dataset" type="observation_rollout_scenario_test.py"
        name="observation_rollout_scenario_test"
        output="screen">
    <param name="config_file" value="$(arg config_file)"/>
    <param name="scenario" value="$(arg scenario)"/>
    <param name="scenario_file" value="$(arg scenario_file)"/>
    <param name="print_decisions" value="$(arg print_decisions)"/>
    <param name="show_plot" value="$(arg show_plot)"/>
    <param name="fail_on_error" value="$(arg fail_on_error)"/>
  </node>
</launch>
